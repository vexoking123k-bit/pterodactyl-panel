FROM node:22-alpine AS frontend
WORKDIR /app
COPY panel-source/package.json panel-source/yarn.lock ./
RUN yarn install --frozen-lockfile
COPY panel-source/ ./
COPY theme-assets/workbench-world.png ./public/assets/workbench-world.png
RUN yarn build:production
FROM ghcr.io/pterodactyl/panel:v1.15.2
COPY --from=frontend --chown=nginx:nginx /app/public/assets/ /app/public/assets/
COPY --chown=nginx:nginx panel-source/app/Repositories/Wings/DaemonRepository.php /app/app/Repositories/Wings/DaemonRepository.php
COPY --chown=nginx:nginx panel-source/config/pterodactyl.php /app/config/pterodactyl.php
